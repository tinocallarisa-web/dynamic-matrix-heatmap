{
    "dataRoles": [
        {
            "displayName": "Dimensions",
            "displayNameKey": "Visual_Dimensions",
            "name": "dimensions",
            "kind": "Grouping",
            "description": "Fields available in the X and Y dropdowns. Up to 10 (Free: 3)."
        },
        {
            "displayName": "Measures",
            "displayNameKey": "Visual_Measures",
            "name": "measures",
            "kind": "Measure",
            "description": "Pre-aggregated DAX measures. Re-aggregated with the mode selected in the Values card. Up to 5 (Free: 2)."
        },
        {
            "name": "weights",
            "kind": "Measure",
            "displayName": "Weights for averages",
            "displayNameKey": "Visual_Weights",
            "description": "A row count, so averages can be combined correctly across the dimensions you did not pick for X and Y. Without it the visual can only average the averages Power BI sent, which weighs every combination the same."
        },
        {
            "displayName": "Distinct count of (Pro)",
            "displayNameKey": "Visual_DistinctFields",
            "name": "distinctFields",
            "kind": "Grouping",
            "description": "Raw ID columns (e.g. customer_id). The visual counts unique values itself, so the result is always correct for any X/Y combination — unlike summing a DAX measure."
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "dimensions": { "min": 0, "max": 10 },
                    "measures": { "min": 0, "max": 5 },
                    "weights": { "min": 0, "max": 1 },
                    "distinctFields": { "min": 0, "max": 3 }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        { "for": { "in": "dimensions" } },
                        { "for": { "in": "distinctFields" } }
                    ],
                    "dataReductionAlgorithm": { "window": { "count": 30000 } }
                },
                "values": {
                    "select": [
                        { "for": { "in": "measures" } },
                        { "for": { "in": "weights" } }
                    ]
                }
            }
        }
    ],
    "objects": {
        "general": {
            "properties": {
                "filter": {
                    "type": { "filter": true }
                }
            }
        },
        "values": {
            "displayName": "Values",
            "displayNameKey": "Visual_Values",
            "properties": {
                "displayMode": {
                    "displayName": "Show value as (Pro)",
                    "type": {
                        "enumeration": [
                            { "value": "absolute", "displayName": "Absolute" },
                            { "value": "pctRow", "displayName": "% of row" },
                            { "value": "pctCol", "displayName": "% of column" },
                            { "value": "pctTotal", "displayName": "% of grand total" }
                        ]
                    }
                },
                "showTotals": {
                    "displayName": "Show totals (Pro)",
                    "type": { "bool": true }
                }
            }
        },
        "heatmap": {
            "displayName": "Heatmap colors",
            "displayNameKey": "Visual_Heatmap",
            "properties": {
                "minColor": {
                    "displayName": "Minimum value color",
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "midColor": {
                    "displayName": "Middle value color",
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "maxColor": {
                    "displayName": "Maximum value color",
                    "type": { "fill": { "solid": { "color": true } } }
                }
            }
        },
        "emptyCells": {
            "displayName": "Empty cells",
            "displayNameKey": "Visual_EmptyCells",
            "properties": {
                "mode": {
                    "displayName": "Display as",
                    "type": {
                        "enumeration": [
                            { "value": "blank", "displayName": "Blank" },
                            { "value": "dash", "displayName": "Dash (-)" },
                            { "value": "zero", "displayName": "Zero (0)" },
                            { "value": "gray", "displayName": "Gray fill" }
                        ]
                    }
                }
            }
        },
        "text": {
            "displayName": "Text",
            "displayNameKey": "Visual_Text",
            "properties": {
                "labelFontFamily": {
                    "displayName": "Axis label font",
                    "type": { "formatting": { "fontFamily": true } }
                },
                "labelFontSize": {
                    "displayName": "Axis label size",
                    "type": { "formatting": { "fontSize": true } }
                },
                "labelColor": {
                    "displayName": "Axis label color",
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "valueFontFamily": {
                    "displayName": "Value font",
                    "type": { "formatting": { "fontFamily": true } }
                },
                "valueFontSize": {
                    "displayName": "Value size",
                    "type": { "formatting": { "fontSize": true } }
                },
                "valueColor": {
                    "displayName": "Value color",
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "controlsBackground": {
                    "displayName": "Controls bar background",
                    "type": { "fill": { "solid": { "color": true } } }
                },
                "controlsFontFamily": {
                    "displayName": "Controls label font",
                    "type": { "formatting": { "fontFamily": true } }
                },
                "controlsFontSize": {
                    "displayName": "Controls label size",
                    "type": { "formatting": { "fontSize": true } }
                },
                "controlsFontColor": {
                    "displayName": "Controls label color",
                    "type": { "fill": { "solid": { "color": true } } }
                }
            }
        },
        "layout": {
            "displayName": "Layout",
            "displayNameKey": "Visual_Layout",
            "properties": {
                "rowHeight": {
                    "displayName": "Row height (px)",
                    "type": { "numeric": true }
                },
                "columnWidth": {
                    "displayName": "Column width (px)",
                    "type": { "numeric": true }
                },
                "columnHeaderOrientation": {
                    "displayName": "Column header orientation",
                    "type": {
                        "enumeration": [
                            { "value": "horizontal", "displayName": "Horizontal" },
                            { "value": "vertical", "displayName": "Vertical (90°)" },
                            { "value": "diagonal", "displayName": "Diagonal (45°)" }
                        ]
                    }
                }
            }
        },
        "selectionState": {
            "properties": {
                "xDimension": { "type": { "text": true } },
                "yDimension": { "type": { "text": true } },
                "valueKey": { "type": { "text": true } },
                "perValue": { "type": { "text": true } }
            }
        }
    },
    "supportsHighlight": true,
    "supportsSynchronizingFilterState": true,
    "supportsLandingPage": true,
    "supportsKeyboardFocus": true,
    "supportsMultiVisualSelection": true,
    "tooltips": {
        "supportedTypes": { "default": true, "canvas": true },
        "roles": ["dimensions"],
        "supportEnhancedTooltips": true
    },
    "privileges": []
}
