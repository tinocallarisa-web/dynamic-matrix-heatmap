{
  "dataRoles": [
    {
      "displayName": "Dimensions",
      "displayNameKey": "Visual_Dimensions",
      "name": "dimensions",
      "kind": "Grouping",
      "description": "Fields available in the X and Y dropdowns. Up to 10 (Free: 3)."
    },
    {
      "displayName": "Measures",
      "displayNameKey": "Visual_Measures",
      "name": "measures",
      "kind": "Measure",
      "description": "Measures or numeric columns, aggregated as set in the field well. Up to 5 (Free: 2)."
    },
    {
      "displayName": "Detail (rows)",
      "displayNameKey": "Visual_DistinctFields",
      "name": "distinctFields",
      "kind": "Grouping",
      "description": "Optional. An ID that identifies each row: the order, ticket or customer. With it, averages and distinct counts are exact for any X/Y pair."
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "dimensions": {
            "min": 0,
            "max": 10
          },
          "measures": {
            "min": 0,
            "max": 5
          },
          "distinctFields": {
            "min": 0,
            "max": 3
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "dimensions"
              }
            },
            {
              "for": {
                "in": "distinctFields"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "measures"
              }
            }
          ]
        }
      }
    }
  ],
